# Cloudflare account ID — used by wrangler for `deploy` / `dev`.
# Find it at: dashboard.cloudflare.com → right sidebar → Account ID.
# Bun's `bun run` commands auto-load .env, so wrangler picks it up via process.env.
CLOUDFLARE_ACCOUNT_ID=""

# Production secrets — also push to Cloudflare via `wrangler secret put`.
BOT_TOKEN="123:ABC..."
WEBHOOK_SECRET="some-random-string"
# 32-byte AES-256-GCM key, base64-encoded. Generate: openssl rand -base64 32
MESSAGE_KEY="generate-with-openssl-rand-base64-32"

# Webhook URL Telegram should POST to — must match the route your Worker serves.
# Example: https://your-bot.example.com/telegram-webhook
WEBHOOK_URL=""

# Optional: Cloudflare API token (Account Analytics:Read) for local scripts
# that query the Workers Analytics Engine SQL API.
CLOUDFLARE_READ_ANALYTICS_TOKEN=""

# Optional: staging environment.
# Push to Cloudflare via:
#   wrangler secret put BOT_TOKEN      --env staging   # paste STAGING_BOT_TOKEN value
#   wrangler secret put MESSAGE_KEY    --env staging   # paste STAGING_MESSAGE_KEY value
#   wrangler secret put WEBHOOK_SECRET --env staging   # paste STAGING_WEBHOOK_SECRET value
STAGING_BOT_TOKEN=""
STAGING_MESSAGE_KEY=""
STAGING_WEBHOOK_SECRET=""
STAGING_WEBHOOK_URL=""

# Privacy-policy contact email shown on /privacy — embedded in the frontend bundle at build.
# VITE_-prefixed vars are read by Vite from this same .env (envDir is the repo root).
VITE_PRIVACY_CONTACT_EMAIL=""
