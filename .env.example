# Production secrets — also push to Cloudflare via `wrangler secret put`.
BOT_TOKEN="123:ABC..."
WEBHOOK_SECRET="some-random-string"
# 32-byte AES-256-GCM key, base64-encoded. Generate: openssl rand -base64 32
MESSAGE_KEY="generate-with-openssl-rand-base64-32"

# Optional: Cloudflare API token (Account Analytics:Read) for local scripts
# that query the Workers Analytics Engine SQL API.
CLOUDFLARE_READ_ANALYTICS_TOKEN=""

# Optional: staging environment.
# Push to Cloudflare via:
#   wrangler secret put BOT_TOKEN      --env staging   # paste BOT_STAGING_TOKEN value
#   wrangler secret put MESSAGE_KEY    --env staging   # paste STAGING_MESSAGE_KEY value
#   wrangler secret put WEBHOOK_SECRET --env staging   # paste STAGING_WEBHOOK_SECRET value
BOT_STAGING_TOKEN=""
STAGING_MESSAGE_KEY=""
STAGING_WEBHOOK_SECRET=""
