{
  "name": "telegram-notify",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["web"],
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply telegram-notify-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-notify-db --remote",
    "set-webhook": "bun run scripts/set-webhook.ts",
    "bot:check": "bun run scripts/check-bot-config.ts",
    "bot:set-commands": "bun run scripts/set-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "bun run --cwd web test",
    "typecheck": "tsc --noEmit && bun run --cwd web typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.71.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/types": "^3.25.0",
    "@hono/valibot-validator": "^0.6.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.41.1",
    "hono": "^4.12.15",
    "valibot": "^1.3.1"
  }
}
